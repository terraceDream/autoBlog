# Copy to .env; start.ps1 loads these values without printing them.
# Default: persistent local H2 database, no extra install required.
# To use PostgreSQL, uncomment these after starting your database:
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/issuedesk
# DB_USER=issuedesk
# DB_PASSWORD=replace-with-your-own-password

YOUTUBE_API_KEY=
# Optional local JDK and frontend port (defaults to PATH Java and port 5173).
# JAVA_HOME=C:/path/to/jdk-17
# FRONTEND_PORT=5174
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional native Codex executable override. Analysis requires ChatGPT login.
# CODEX_EXECUTABLE=C:/path/to/codex.exe
